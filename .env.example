# Copy to .env and fill in GROQ_API_KEY. .env is gitignored — never commit real secrets.
#   cp .env.example .env
# The defaults below let the app boot immediately; add your Groq key for real answers.

# --- Groq (open-source LLMs via GroqCloud) ---
# Get a free key at https://console.groq.com/keys . Without it, the chatbot returns
# stub answers so the UI still runs.
GROQ_API_KEY=
# Optional model overrides (sensible defaults live in app/backend/settings.py):
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_JUDGE_MODEL=llama-3.1-8b-instant

# --- App / auth ---
# Session-signing key. Leave blank to have the container generate + persist one.
# To set your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seed admin account (created on first startup). Change the password before sharing.
ADMIN_EMAIL=admin@floor.local
ADMIN_NAME=Plant Admin
ADMIN_PASSWORD=admin123

# Optional demo employee (seeded only if DEMO_PASSWORD is set).
DEMO_EMAIL=supervisor@floor.local
DEMO_PASSWORD=floor123

# --- Future (not yet wired) ---
# REDIS_URL=redis://localhost:6379/0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
