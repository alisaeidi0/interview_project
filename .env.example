# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- App / auth (frontend slice) ---
# Signing key for JWT session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Session lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Seed demo supervisor account (dev only). The app hashes this at startup.
DEMO_USERNAME=supervisor
DEMO_PASSWORD=

# --- Backend: agent (Groq) ---
# Required for the real agent. Without it, /api/chat falls back to the stub.
GROQ_API_KEY=
# Optional overrides (sensible defaults in app/backend/settings.py):
# GROQ_MODEL=llama-3.3-70b-versatile        # generation
# GROQ_JUDGE_MODEL=llama-3.1-8b-instant     # router + groundedness judge
# EMBED_MODEL=BAAI/bge-small-en-v1.5         # local embeddings (no API)
# RERANK_MODEL=BAAI/bge-reranker-base        # local cross-encoder (no API)

# --- Backend: future (not yet wired) ---
# REDIS_URL=redis://localhost:6379/0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
