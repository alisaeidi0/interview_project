# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- App / auth (frontend slice) ---
# Signing key for JWT session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Session lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Seed demo supervisor account (dev only). The app hashes this at startup.
DEMO_USERNAME=supervisor
DEMO_PASSWORD=

# --- Backend (added when we build it; listed here so config is discoverable) ---
# GROQ_API_KEY=            # <-- Groq key (open-source models). Confirm the exact name.
# GROQ_MODEL=llama-3.3-70b-versatile
# CHROMA_PERSIST_DIR=./data/chroma
# REDIS_URL=redis://localhost:6379/0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
